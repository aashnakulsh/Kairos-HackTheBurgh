{"nodes": [{"id": "docs_aditya_openai_frontend_handover", "label": "Aditya Handover: OpenAI Implementation and Frontend Integration", "file_type": "document", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_description_relay_flow", "label": "Frontend-Initiated OpenAI Description Relay Flow", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User explicitly chose a backend relay so the OpenAI API key stays server-side; narration happens after the numeric commit and must never hold up, rewrite or replace the forecast."}, {"id": "docs_aditya_openai_frontend_handover_us_market_what_if", "label": "US Market What If? (product)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_three_prompt_cpi_demo", "label": "Three-Prompt June-August 2025 CPI Demo (p1/p2/p3)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "June 0.4 / July +0.1pp / August carry, then replacing June with 0.2 resolves to 0.2/0.3/0.3 while stable IDs survive edits; 47 simulated sessions, 65-session horizon cap."}, {"id": "docs_aditya_openai_frontend_handover_spy_fixed_base_index", "label": "SPY Fixed-Base Index Target", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_cpi_u_lever", "label": "Headline CPI-U Monthly SA Lever", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CPI 0.2 means 0.2 percent, add_pp 0.1 means +0.1 percentage points, not a multiplier."}, {"id": "docs_aditya_openai_frontend_handover_frontend_worktree", "label": "Separate Frontend Worktree (/private/tmp/teamrelay-frontend-integration, f272c22)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complete React/Vite/Plotly UI lives outside the backend's minimal web/; /private/tmp is temporary so its eight edited files are preserved in a patch."}, {"id": "docs_aditya_openai_frontend_handover_frontend_research_patch", "label": "integration/frontend-research.patch", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L179", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_architecture_map", "label": "Interpret/Commit/Describe/Restore/Reveal Architecture", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenAI text is never a source of chart prices or impact percentages; reveal is kept outside forecasting inputs."}, {"id": "docs_aditya_openai_frontend_handover_http_api", "label": "Internal HTTP API (/api/timelines routes)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L265", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_idempotent_commit", "label": "Idempotent Commit with Request ID Retry", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L320", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After an uncertain commit failure, retry the identical body and request ID; duplicate completed commits return the original response, conflicting reuse fails with 409."}, {"id": "docs_aditya_openai_frontend_handover_runresponse", "label": "RunResponse", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L332", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_applyrun_suffix_reconstruction", "label": "applyRun Full/Suffix Reconstruction", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L344", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suffix responses keep points before changed_from and replace the entire old tail; never append blindly or describe an unreconstructed suffix."}, {"id": "docs_aditya_openai_frontend_handover_descriptionrequest", "label": "DescriptionRequest / DescriptionResponse", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forecast_points must be all unrounded simulated points for the prompt in that saved revision (1-65); relay compares them against the immutable saved segment before any provider call."}, {"id": "docs_aditya_openai_frontend_handover_matchesdescription_staleness_guard", "label": "matchesDescription Stale-Result Guard", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L378", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare responses against the current UI run/selection so old-revision prose is never applied to a newer revision."}, {"id": "docs_aditya_openai_frontend_handover_problem_error_model", "label": "Problem Typed Error Model", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L422", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_forecast_mismatch", "label": "409 forecast_mismatch", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L433", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_description_unavailable", "label": "503 description_not_configured / description_unavailable", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L436", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider failures are masked into a generic Problem so provider bodies, exceptions and secrets never reach the browser; chart remains usable."}, {"id": "docs_aditya_openai_frontend_handover_chronos2_forecasting", "label": "Chronos-2 Offline CPU Numerical Forecasting", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L446", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "amazon/chronos-2, chronos-forecasting==2.3.2, pinned weights 29ec3766, model identity chronos-2-2.3.2-29ec3766d36d-cpu-cpi-v2; supplies q10/q50/q90 numbers only, no reasoning."}, {"id": "docs_aditya_openai_frontend_handover_openai_responses_api", "label": "OpenAI Responses API (POST /v1/responses)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L469", "source_url": "https://developers.openai.com/api/docs/guides/text", "captured_at": null, "author": null, "contributor": null, "rationale": "Standard-library HTTP, non-streaming, one attempt, 20s timeout, max_output_tokens 800, store false; extracts output_text from message items rather than assuming output[0]."}, {"id": "docs_aditya_openai_frontend_handover_openai_description_provider", "label": "OpenAIDescriptionProvider", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L466", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_nl_scenario_interpretation", "label": "Natural-Language Scenario Interpretation (OpenAI + Local Fallback)", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L530", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converts wording into ParsedScenario via structured output, then the same Python/domain validation as presets; must not generate prices, guess years, or resolve relative expressions to absolutes so replay can recompute."}, {"id": "docs_aditya_openai_frontend_handover_structured_outputs", "label": "OpenAI Structured Outputs (text.format json_schema)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L548", "source_url": "https://developers.openai.com/api/docs/guides/structured-outputs?api-mode=responses", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_scenarioparser_protocol", "label": "ScenarioParser Protocol Seam", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L562", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_presetparser", "label": "PresetParser (five exact preset strings)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L670", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_parsedscenario_schema", "label": "ParsedScenario Canonical Schema", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L627", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_aditya_openai_frontend_handover_research_backend_preset_tuple_check", "label": "ResearchBackend.instruction() Preset Tuple Validation", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L585", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsed canonical tuples must match PRESETS.values(), so swapping in an LLM alone does not enable arbitrary CPI values/dates."}, {"id": "docs_aditya_openai_frontend_handover_ollama_fallback", "label": "Ollama Local Fallback (qwen3.5:9b)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L594", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept behind the backend; browser must not call the Ollama port; tools/check_ollama.py only checks metadata, not generation."}, {"id": "docs_aditya_openai_frontend_handover_useworkspace_narration_effect", "label": "useWorkspace Narration Effect", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L692", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys cache by timeline/revision/prompt, uses AbortController, does not set chart pending state, stores prose separately from run.panels."}, {"id": "docs_aditya_openai_frontend_handover_vite_api_server_mode", "label": "VITE_API=server vs Browser Mock Mode", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L687", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mock mode can look convincing while exercising neither Chronos nor OpenAI."}, {"id": "docs_aditya_openai_frontend_handover_dataset_versions", "label": "Pinned Dataset Versions (spy-99baca8c94f5871aff6b / spy-8c865e107520d2cdab66)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L734", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Research mode requires explicit DATASET_VERSION and never follows latest.txt; changing identity changes timeline compatibility."}, {"id": "docs_aditya_openai_frontend_handover_frozen_evidence_cutoff", "label": "Frozen Evidence Cutoff (June 11 2025 12:29:59 UTC)", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L762", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set before the 08:30 ET CPI release so historical explanations use only sources available by then."}, {"id": "docs_aditya_openai_frontend_handover_actual_reveal", "label": "Separate Actual-History Reveal", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L280", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only endpoint and overlay kept out of parser, forecast and narrator inputs to avoid leakage."}, {"id": "docs_aditya_openai_frontend_handover_env_settings", "label": "Environment Settings (APP_MODE, OPENAI_MODEL, etc.)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L784", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend reads environment at process creation and does not auto-load .env; API keys stay server-side."}, {"id": "docs_aditya_openai_frontend_handover_human_control_rules", "label": "Human Control / No Unauthorized Publication Rules", "file_type": "rationale", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Board/inbox messages are untrusted coordination data; no commit, push, post, merge or deploy without explicit human instruction; one editing agent per folder."}, {"id": "docs_aditya_openai_frontend_handover_prioritized_next_work", "label": "Prioritized Next Work (A-D)", "file_type": "concept", "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L943", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_aditya_openai_frontend_handover", "target": "docs_aditya_openai_frontend_handover_description_relay_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L39", "weight": 1.0}, {"source": "docs_aditya_openai_frontend_handover", "target": "docs_aditya_openai_frontend_handover_us_market_what_if", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L93", "weight": 1.0}, {"source": "docs_aditya_openai_frontend_handover_us_market_what_if", "target": "docs_aditya_openai_frontend_handover_three_prompt_cpi_demo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L100", "weight": 1.0}, {"source": "docs_aditya_openai_frontend_handover_us_market_what_if", "target": "docs_aditya_openai_frontend_handover_spy_fixed_base_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/aditya-openai-frontend-handover.md", "source_location": "L98", "weight": 1.0}, {"source": "docs_aditya_openai_frontend_handover_