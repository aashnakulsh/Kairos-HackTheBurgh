        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "impacts": {
