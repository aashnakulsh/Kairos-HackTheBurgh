          },
          "title": "Impacts",
          "type": "array"
        },
        "horizon": {
          "title": "Horizon",
          "type": "string"
        },
        "comparison": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Comparison"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "support_count": {
          "minimum": 0,
          "title": "Support Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "hypotheses",
        "evidence",
        "impacts",
        "horizon",
        "comparison",
        "engine",
        "support_count",
        "status"
      ],
      "title": "Panel",
      "type": "object"
    },
