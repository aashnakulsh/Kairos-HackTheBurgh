    "Impact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "emoji": {
          "title": "Emoji",
          "type": "string"
        },
        "exposure": {
          "enum": [
            "direct",
            "indirect"
          ],
          "title": "Exposure",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction"
        },
        "metric_kind": {
          "enum": [
            "proxy_change",
            "index_contribution",
            "qualitative"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "magnitude": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Magnitude"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "percent",
                "percentage_points"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "comparator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Comparator"
        },
        "horizon": {
          "title": "Horizon",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "emoji",
        "exposure",
        "direction",
        "metric_kind",
        "magnitude",
        "unit",
        "comparator",
        "horizon",
        "method",
        "source_ids"
      ],
      "title": "Impact",
      "type": "object"
    },
    "Instruction": {
      "additionalProperties": false,
      "description": "Backend-validated instruction; relative expressions stay relative.",
      "properties": {
        "date_precision": {
          "enum": [
            "day",
            "year",
            "interval"
          ],
          "title": "Date Precision",
          "type": "string"
        },
        "requested_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Requested Start",
          "type": "string"
        },
        "requested_end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested End"
        },
        "effective_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Effective Start",
          "type": "string"
        },
        "effective_end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective End"
        },
        "effective_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(Z|[+-]\\d{2}:\\d{2})$",
          "title": "Effective At",
          "type": "string"
        },
        "timezone": {
          "const": "America/New_York",
          "title": "Timezone",
          "type": "string"
        },
        "scope": {
          "enum": [
            "release",
            "interval",
            "recurring",
            "event"
          ],
          "title": "Scope",
          "type": "string"
        },
        "release_dates": {
          "items": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "title": "Release Dates",
          "type": "array"
        },
        "operation": {
          "enum": [
            "set",
            "add_pp",
            "carry",
            "scenario"
          ],
          "title": "Operation",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "percent",
            "percentage_points",
            "scenario"
          ],
          "title": "Unit",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        },
        "scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "date_precision",
        "requested_start",
        "requested_end",
        "effective_start",
        "effective_end",
        "effective_at",
        "timezone",
        "scope",
        "release_dates",
        "operation",
        "value",
        "unit",
        "reference"
      ],
      "title": "Instruction",
      "type": "object"
    },
