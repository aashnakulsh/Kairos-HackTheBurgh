{
  "$defs": {
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1",
          "title": "Contract Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "fixture",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "data_label": {
          "title": "Data Label",
          "type": "string"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        },
        "unit": {
          "const": "index",
          "title": "Unit",
          "type": "string"
        },
        "frequency": {
          "const": "trading_session",
          "title": "Frequency",
          "type": "string"
        },
        "default_viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "supported_event_families": {
          "items": {
            "type": "string"
          },
          "title": "Supported Event Families",
          "type": "array"
        },
        "default_horizon_sessions": {
          "minimum": 1,
          "title": "Default Horizon Sessions",
          "type": "integer"
        },
        "max_horizon_sessions": {
          "minimum": 1,
          "title": "Max Horizon Sessions",
          "type": "integer"
        },
        "max_prompts": {
          "minimum": 1,
          "title": "Max Prompts",
          "type": "integer"
        },
        "evidence_available": {
          "title": "Evidence Available",
          "type": "boolean"
        },
        "display_rights": {
          "title": "Display Rights",
          "type": "string"
        },
        "fixture_presets": {
          "items": {
            "type": "string"
          },
          "title": "Fixture Presets",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "mode",
        "data_label",
        "targets",
        "unit",
        "frequency",
        "default_viewport",
        "coverage",
        "supported_event_families",
        "default_horizon_sessions",
        "max_horizon_sessions",
        "max_prompts",
        "evidence_available",
        "display_rights",
        "fixture_presets"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "CommitRequest": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "expected_revision",
        "request_id"
      ],
      "title": "CommitRequest",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "first_session": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "First Session",
          "type": "string"
        },
        "last_session": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Last Session",
          "type": "string"
        },
        "gaps": {
          "items": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "first_session",
        "last_session",
        "gaps"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CreateTimelineRequest": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "const": "SPY",
          "title": "Target Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "request_id"
      ],
      "title": "CreateTimelineRequest",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "publication_time": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(Z|[+-]\\d{2}:\\d{2})$",
          "title": "Publication Time",
          "type": "string"
        },
        "passage_locator": {
          "title": "Passage Locator",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "publication_time",
        "passage_locator"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ForecastRequest": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "base_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Base Date",
          "type": "string"
        },
        "base_value": {
          "exclusiveMinimum": 0,
          "title": "Base Value",
          "type": "number"
        },
        "evidence_cutoff": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(Z|[+-]\\d{2}:\\d{2})$",
          "title": "Evidence Cutoff",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryRow"
          },
          "minItems": 1,
          "title": "History",
          "type": "array"
        },
        "future": {
          "items": {
            "$ref": "#/$defs/FutureRow"
          },
          "maxItems": 65,
          "minItems": 1,
          "title": "Future",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "target_id",
        "segment_id",
        "base_date",
        "base_value",
        "evidence_cutoff",
        "dataset_version",
        "model_version",
        "history",
        "future",
        "assumptions"
      ],
      "title": "ForecastRequest",
      "type": "object"
    },
    "ForecastResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "support_count": {
          "minimum": 0,
          "title": "Support Count",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Points",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "status",
        "reason",
        "engine",
        "model_version",
        "support_count",
        "points",
        "assumptions"
      ],
      "title": "ForecastResult",
      "type": "object"
    },
    "FutureRow": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "cpi_percent": {
          "title": "Cpi Percent",
          "type": "number"
        },
        "release_indicator": {
          "enum": [
            0,
            1
          ],
          "title": "Release Indicator",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "cpi_percent",
        "release_indicator"
      ],
      "title": "FutureRow",
      "type": "object"
    },
    "HistoryRow": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "number"
        },
        "kind": {
          "enum": [
            "observed",
            "simulated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "available_at": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(Z|[+-]\\d{2}:\\d{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available At"
        },
        "cpi_percent": {
          "title": "Cpi Percent",
          "type": "number"
        },
        "release_indicator": {
          "enum": [
            0,
            1
          ],
          "title": "Release Indicator",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "level",
        "kind",
        "available_at",
        "cpi_percent",
        "release_indicator"
      ],
      "title": "HistoryRow",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "user_assumption": {
          "title": "User Assumption",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "source_ids",
        "user_assumption"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Impact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "emoji": {
          "title": "Emoji",
          "type": "string"
        },
        "exposure": {
          "enum": [
            "direct",
            "indirect"
          ],
          "title": "Exposure",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction"
        },
        "metric_kind": {
          "enum": [
            "proxy_change",
            "index_contribution",
            "qualitative"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "magnitude": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Magnitude"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "percent",
                "percentage_points"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "comparator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Comparator"
        },
        "horizon": {
          "title": "Horizon",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "emoji",
        "exposure",
        "direction",
        "metric_kind",
        "magnitude",
        "unit",
        "comparator",
        "horizon",
        "method",
        "source_ids"
      ],
      "title": "Impact",
      "type": "object"
    },
    "Instruction": {
      "additionalProperties": false,
      "description": "Backend-validated instruction; relative expressions stay relative.",
      "properties": {
        "date_precision": {
          "enum": [
            "day",
            "year",
            "interval"
          ],
          "title": "Date Precision",
          "type": "string"
        },
        "requested_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Requested Start",
          "type": "string"
        },
        "requested_end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested End"
        },
        "effective_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Effective Start",
          "type": "string"
        },
        "effective_end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective End"
        },
        "effective_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(Z|[+-]\\d{2}:\\d{2})$",
          "title": "Effective At",
          "type": "string"
        },
        "timezone": {
          "const": "America/New_York",
          "title": "Timezone",
          "type": "string"
        },
        "scope": {
          "enum": [
            "release",
            "interval",
            "recurring"
          ],
          "title": "Scope",
          "type": "string"
        },
        "release_dates": {
          "items": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "title": "Release Dates",
          "type": "array"
        },
        "operation": {
          "enum": [
            "set",
            "add_pp",
            "carry"
          ],
          "title": "Operation",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "percent",
            "percentage_points"
          ],
          "title": "Unit",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        }
      },
      "required": [
        "date_precision",
        "requested_start",
        "requested_end",
        "effective_start",
        "effective_end",
        "effective_at",
        "timezone",
        "scope",
        "release_dates",
        "operation",
        "value",
        "unit",
        "reference"
      ],
      "title": "Instruction",
      "type": "object"
    },
    "InterpretRequest": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "mode": {
          "enum": [
            "add",
            "replace"
          ],
          "title": "Mode",
          "type": "string"
        },
        "selected_prompt_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Prompt Id"
        },
        "playhead": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playhead"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "text",
        "mode",
        "expected_revision"
      ],
      "title": "InterpretRequest",
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
