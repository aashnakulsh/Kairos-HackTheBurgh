# Proposed live server settings. The fixture server never reads these or calls models.
# Never put an event key in VITE_* variables or browser code.
APP_MODE=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=12
FORECAST_MODEL=amazon/chronos-2
FORECAST_DEVICE=cpu
FORECAST_TIMEOUT_SECONDS=30
DATA_DIR=./data/local
SQLITE_PATH=./data/local/teamrelay.sqlite
BACKGROUND_MODE=gradient
