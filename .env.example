# Durable API settings. api.fixture_app always remains synthetic.
# Export these in your terminal; api.app does not automatically load this file.
# Never put an event key in VITE_* variables or browser code.
APP_MODE=fixture
# To run the bounded June real-data API, export APP_MODE=research and pin this snapshot:
# DATASET_VERSION=spy-99baca8c94f5871aff6b
# SQLITE_PATH=./data/local/teamrelay-research.sqlite
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PARSER_PROVIDER=deterministic
# Set PARSER_PROVIDER=auto for OpenAI with local Ollama fallback, or ollama for local only.
OPENAI_TIMEOUT_SECONDS=5
# Separate frontend-initiated narration relay; one attempt, no effect on saved forecasts.
# OPENAI_MODEL must name a text model available to your API project.
OPENAI_DESCRIPTION_TIMEOUT_SECONDS=20
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=12
FORECAST_MODEL=amazon/chronos-2
FORECAST_DEVICE=cpu
FORECAST_TIMEOUT_SECONDS=30
DATA_DIR=./data/local
SQLITE_PATH=./data/local/teamrelay.sqlite
BACKGROUND_MODE=gradient
